# ──────────────────────────────────────
# CaseDex Production Environment
# Copy to .env and fill in all values
# ──────────────────────────────────────

# ─── Domain ───────────────────────────
DOMAIN=casedex.app
NEXT_PUBLIC_API_BASE_URL=https://casedex.app
NEXT_PUBLIC_APP_URL=https://casedex.app

# ─── Laravel App ──────────────────────
APP_NAME=CaseDex
APP_ENV=production
APP_KEY=  # Run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://casedex.app
FRONTEND_URL=https://casedex.app
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# ─── Database ─────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=casedex
DB_USERNAME=casedex
DB_PASSWORD=  # CHANGE THIS — use: openssl rand -base64 32
DB_ROOT_PASSWORD=  # CHANGE THIS — use: openssl rand -base64 32

# ─── Redis ────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=casedex-db-

# ─── Cache & Queue ────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_DOMAIN=.casedex.app
SESSION_SECURE_COOKIE=true

# ─── Storage (Cloudflare R2) ─────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=casedex-documents
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Email (Resend) ──────────────────
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@casedex.app
MAIL_FROM_NAME=CaseDex

# ─── Billing (Lemon Squeezy) ─────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE=
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_REDIRECT_URL=https://casedex.app/settings/billing

LEMON_SQUEEZY_STARTER_MONTHLY_VARIANT=
LEMON_SQUEEZY_STARTER_YEARLY_VARIANT=
LEMON_SQUEEZY_PROFESSIONAL_MONTHLY_VARIANT=
LEMON_SQUEEZY_PROFESSIONAL_YEARLY_VARIANT=
LEMON_SQUEEZY_CHAMBERS_MONTHLY_VARIANT=
LEMON_SQUEEZY_CHAMBERS_YEARLY_VARIANT=
LEMON_SQUEEZY_UNLIMITED_STORAGE_VARIANT=

# ─── AI Credit Packs (Lemon Squeezy) ─
LEMON_SQUEEZY_AI_PACK_SMALL_VARIANT=
LEMON_SQUEEZY_AI_PACK_MEDIUM_VARIANT=
LEMON_SQUEEZY_AI_PACK_LARGE_VARIANT=

# ─── AI Provider (Groq) ──────────────
AI_DRIVER=openai_compatible
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_MONTHLY_FREE_CREDITS=100

# ─── WhatsApp (optional) ─────────────
WHATSAPP_DRIVER=null
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Push Notifications ──────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Monitoring ───────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=

# ─── Logging ─────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
