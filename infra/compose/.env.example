# Host port overrides for docker-compose.yml.
# Copy to `.env` and customize per machine. Container-internal ports are unchanged,
# so service-to-service URLs (mysql:3306, redis:6379, mailhog:1025, etc.) stay the same.

# NGINX_PORT=8080
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# MYSQL_PORT=3301
# REDIS_PORT=6379
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILHOG_SMTP_PORT=1025
# MAILHOG_UI_PORT=8025
